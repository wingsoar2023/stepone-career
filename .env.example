# 3. RevenueCat (iOS In-App Purchase). Public SDK key from
#    https://app.revenuecat.com -> Project -> API Keys -> "Public app-specific key" (Apple)
VITE_REVENUECAT_PUBLIC_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxx
